# ─────────────────────────────────────────────────────────────────────────────
# REQUESTLUXURY.COM — environment variables
# Copy to .env.local for local development; add the same keys in
# Vercel → Project → Settings → Environment Variables for production.
# The site builds and runs with none of these set: each integration switches
# on when its keys are present.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical site URL (no trailing slash). Feeder domains 301-redirect here.
NEXT_PUBLIC_SITE_URL=https://requestluxury.com

# Supabase → Project Settings → API. The anon slot also accepts a publishable
# key (sb_publishable_…) and the service-role slot a secret key (sb_secret_…).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary → Settings → API Keys (image and video uploads from /admin and /dealer)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe → Developers → API keys, and the signing secret of the webhook endpoint
# https://requestluxury.com/api/stripe/webhook
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend → API Keys. Without it, emails are printed to the server log instead.
RESEND_API_KEY=

# Where lead and payment notifications are sent.
ADMIN_EMAIL=concierge@requestluxury.com

# ── Optional ─────────────────────────────────────────────────────────────────
# Sender shown on outgoing email. The domain must be verified in Resend.
EMAIL_FROM=RequestLuxury Concierge <concierge@requestluxury.com>
# Concierge WhatsApp number in international format, digits only (e.g. 447700900123).
# Used for the 1-click WhatsApp enquiry when a dealer has no number of their own.
NEXT_PUBLIC_CONCIERGE_WHATSAPP=
# Currency Stripe charges in: gbp (default), eur or usd. Listing prices are converted at the live rate.
STRIPE_CHECKOUT_CURRENCY=gbp
# Villiers Jets affiliate id (the number in your Villiers affiliate link).
NEXT_PUBLIC_VILLIERS_AFFILIATE_ID=
# Yacht charter partner affiliate link, if you have one.
NEXT_PUBLIC_YACHT_CHARTER_AFFILIATE_URL=
